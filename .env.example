# Required for the default OpenAI-backed analyzer and optional live tests.
# Never commit a real key.
OPENAI_API_KEY=
RUN_LIVE_MODEL_TESTS=0

# Service defaults
DOCUMENT_PROCESSING_MODEL=gpt-5.6-luna
DOCUMENT_PROCESSING_ARTIFACT_ROOT=./var/document-processing
DOCUMENT_PROCESSING_HOST=127.0.0.1
DOCUMENT_PROCESSING_PORT=8000
DOCUMENT_PROCESSING_REASONING_EFFORT=medium
DOCUMENT_PROCESSING_RENDER_DPI=200
DOCUMENT_PROCESSING_MAX_UPLOAD_BYTES=104857600
DOCUMENT_PROCESSING_MAX_PAGES=1000
DOCUMENT_PROCESSING_MAX_RENDERED_MEGAPIXELS=40.0
DOCUMENT_PROCESSING_MODEL_TIMEOUT_SECONDS=180.0
DOCUMENT_PROCESSING_MAX_MODEL_ATTEMPTS=3
DOCUMENT_PROCESSING_WORKER_QUEUE_CAPACITY=100
DOCUMENT_PROCESSING_SHUTDOWN_GRACE_SECONDS=30.0
DOCUMENT_PROCESSING_PAGE_LIST_DEFAULT_LIMIT=100
DOCUMENT_PROCESSING_PAGE_LIST_MAX_LIMIT=500
